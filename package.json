{
  "name": "rekoda",
  "private": true,
  "version": "0.1.0",
  "description": "WhatsApp-first financial operating assistant \u2014 you run the business, Rekoda builds the records.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "demo:m0": "pnpm --filter @rekoda/core demo",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
    "screenshots": "node scripts/screenshots.mjs",
    "boundaries": "node scripts/check-boundaries.mjs",
    "test:integration": "pnpm --filter @rekoda/db test:integration && pnpm --filter @rekoda/api test:integration",
    "e2e": "pnpm --filter @rekoda/web e2e",
    "migrate": "pnpm --filter @rekoda/db migrate:apply"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
