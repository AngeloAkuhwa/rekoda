{
  "name": "@rekoda/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    },
    "./privacy": {
      "types": "./dist/privacy.d.ts",
      "default": "./dist/privacy.js"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "default": "./dist/vault.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "tsx src/demo/m0-balanced-sale.ts",
    "lint": "prettier --check src"
  },
  "dependencies": {
    "@rekoda/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7",
    "vitest": "^4.1.11"
  }
}
