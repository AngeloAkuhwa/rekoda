{
  "openapi": "3.1.0",
  "info": {
    "title": "Rekoda Merchant API",
    "version": "1.0.0",
    "summary": "What a program may read and write on behalf of one business.",
    "description": "Hand written against the code, and kept honest by `scripts/check-openapi.mjs`, which fails CI when a route exists in one and not the other.\n\nThree rules shape every schema here, and they are the reason this is not generated from the database:\n\n- **Money is integer kobo.** A program sends and receives minor units; the float that would otherwise arrive is the bug this avoids.\n- **A customer is a pseudonym.** Names and phone numbers live encrypted, one facet per row. A partner integration is not a reason to turn this into a PII export, so no identity facet has a field here.\n- **No column travels verbatim.** Internals are absent, not renamed.\n\nThe API is a separate commercial entitlement: a business holds `REKODA_API` because it was granted, and holds capacity because it was bought.",
    "license": {
      "name": "Proprietary",
      "url": "https://rekoda.app/terms"
    }
  },
  "servers": [
    {
      "url": "https://api.rekoda.app",
      "description": "Production"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Identity",
      "description": "Who the presented key speaks for."
    },
    {
      "name": "Reads",
      "description": "The merchant's books, as this key may see them."
    },
    {
      "name": "Writes",
      "description": "Live keys only. A test key reads the same books and writes nothing."
    }
  ],
  "paths": {
    "/api/v1/identity": {
      "get": {
        "operationId": "getIdentity",
        "tags": [
          "Identity"
        ],
        "summary": "Who this key speaks for",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "401": {
            "description": "No credential, or one that is not usable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A live key refused: not entitled, or this key may not do this.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such thing, or nothing this caller may see. The two are one answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "The per-key ceiling, or the month's capacity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/customers": {
      "get": {
        "operationId": "listCustomers",
        "tags": [
          "Reads"
        ],
        "summary": "The merchant's customers, as pseudonyms",
        "parameters": [
          {
            "$ref": "#/components/parameters/cursor"
          },
          {
            "$ref": "#/components/parameters/limit"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerPage"
                }
              }
            }
          },
          "401": {
            "description": "No credential, or one that is not usable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A live key refused: not entitled, or this key may not do this.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such thing, or nothing this caller may see. The two are one answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "The per-key ceiling, or the month's capacity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "operationId": "listProducts",
        "tags": [
          "Reads"
        ],
        "summary": "The catalogue",
        "parameters": [
          {
            "$ref": "#/components/parameters/cursor"
          },
          {
            "$ref": "#/components/parameters/limit"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          },
          "401": {
            "description": "No credential, or one that is not usable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A live key refused: not entitled, or this key may not do this.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such thing, or nothing this caller may see. The two are one answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "The per-key ceiling, or the month's capacity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invoices": {
      "get": {
