{
  "name": "@rekoda/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.119.0",
    "@aws-sdk/client-s3": "^3.1113.0",
    "@fastify/rate-limit": "^11.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@rekoda/contracts": "workspace:*",
    "@rekoda/core": "workspace:*",
    "@rekoda/db": "workspace:*",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pdfkit": "^0.17.6",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^7",
    "vitest": "^4.1.11"
  }
}
