# ══════════════════════════════════════════════════════════════════════════
# Rekoda — environment configuration
# Copy to .env and fill. The application refuses to boot with missing or
# malformed values and names the exact problem (doctor-on-boot).
# NOTHING in this file's real counterpart is ever committed.
# ══════════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public origin, no trailing slash (webhooks, links, canonical URLs).
APP_URL=http://localhost:3000

# ── apps/api ───────────────────────────────────────────────────────────────
# Where apps/web reaches identity. The web tier holds no database handle and no
# signing secret; this is its only route to either (ADR 0020).
REKODA_API_URL=http://127.0.0.1:3001
# Comma-separated allowlist. Credentials travel in the Authorization header,
# never a cross-site cookie, so this is an allowlist and never a reflection.
REKODA_CORS_ORIGINS=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────
# What the APPLICATION uses: the rekoda_app role — RLS-constrained, not the
# table owner, no BYPASSRLS. Running the app as the owner disables every tenant
# policy silently, so this must never be the owner's connection string.
DATABASE_URL=postgres://rekoda_app@localhost:5432/rekoda
# Owner connection, used ONLY to run migrations (pnpm --filter @rekoda/db
# migrate:apply) and never by a running application.
OWNER_DATABASE_URL=postgres://rekoda@localhost:5432/rekoda

# ── Security keys (generate each: openssl rand -hex 32) ────────────────────
# Encrypts vault ciphertexts (customer identities). Rotation = re-encryption
# migration; see docs/runbooks/key-rotation.md (M2).
VAULT_KEY=
# Keyed HMAC for deterministic identity matching (separate from VAULT_KEY).
MATCH_KEY=
# Encrypts merchant provider credentials (Paystack keys etc.).
CONNECTION_KEY=
# Session cookie signing.
SESSION_SECRET=
# Signs setup grants — the short-lived credential that bridges "phone verified"
# and "business exists" (ADR 0020). Minimum 32 characters; the API refuses to
# boot without it.
REKODA_API_SECRET=
# Server-side pepper for OTP hashing, never stored beside the hash. A 6-digit
# code under an unsalted digest is a 10^6 keyspace and reversible in under a
# second, so a database dump alone must not be enough to invert it.
# Minimum 32 characters. Changing it invalidates every OTP in flight.
OTP_PEPPER=

# ── Test hooks — MUST be unset everywhere real ─────────────────────────────
# Returns live OTP codes in the API response so the end-to-end suite can
# complete the flow without a WhatsApp account. The API REFUSES TO BOOT with
# this set when NODE_ENV=production. Set only by playwright.config.ts.
# REKODA_REVEAL_OTP=1
# REKODA_E2E_REVEAL_OTP=1

# ── WhatsApp — Rekoda Chat (Meta Cloud API direct, ADR 0002) ───────────────
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ── Paystack (Rekoda's own billing) ────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CHAT=
PAYSTACK_PLAN_INTEGRATE=
PAYSTACK_PLAN_COMPLETE=

# ── AI (ADR 0007) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-latest
AI_MODEL_CLASSIFIER=claude-haiku-latest
# Escalation tier — OFF at launch; set a model id to enable.
AI_MODEL_ESCALATION=

# ── STT sidecar (ADR 0005) ─────────────────────────────────────────────────
STT_URL=http://localhost:8081
# Fallback provider if the accent benchmark demands it (privacy copy must
# be updated when enabled): openai | none
STT_FALLBACK=none
OPENAI_API_KEY=

# ── Object storage (Cloudflare R2, ADR 0006) ───────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rekoda-documents

# ── Cost telemetry ─────────────────────────────────────────────────────────
# Planning FX for naira-equivalent COGS rows (pricing-model.md).
PLANNING_FX_NGN_PER_USD=1450
