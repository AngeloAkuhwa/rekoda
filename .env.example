# ══════════════════════════════════════════════════════════════════════════
# Rekoda — environment configuration
# Copy to .env and fill. The application refuses to boot with missing or
# malformed values and names the exact problem (doctor-on-boot).
# NOTHING in this file's real counterpart is ever committed.
# ══════════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public origin, no trailing slash (webhooks, links, canonical URLs).
APP_URL=http://localhost:3000

# ── Public site ────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Feeds canonical URLs, robots.txt and
# sitemap.xml — a wrong value here silently tells search engines the real site
# lives somewhere else.
NEXT_PUBLIC_SITE_URL=https://rekoda.app

# ── Legal pages ────────────────────────────────────────────────────────────
# Anything left blank renders as a visible "not set yet" badge on the policy
# pages rather than as empty space or a plausible-looking placeholder. A policy
# that names the wrong entity is worse than one that admits it is unfinished.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_RC_NUMBER=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_NDPR_AUDITOR=

# ── apps/api ───────────────────────────────────────────────────────────────
# Where apps/web reaches identity. The web tier holds no database handle and no
# signing secret; this is its only route to either (ADR 0020).
REKODA_API_URL=http://127.0.0.1:3001
# Comma-separated allowlist. Credentials travel in the Authorization header,
# never a cross-site cookie, so this is an allowlist and never a reflection.
REKODA_CORS_ORIGINS=http://localhost:3000
# Requests per IP per minute. Bounds the cost attack that per-phone limits
# cannot see: a caller walking through thousands of DIFFERENT numbers, each
# one spending money on a WhatsApp template message. In-memory, so the ceiling
# is per instance until it gets a shared store.
REKODA_RATE_LIMIT_MAX=60

# ── Database ───────────────────────────────────────────────────────────────
# What the APPLICATION uses: the rekoda_app role — RLS-constrained, not the
# table owner, no BYPASSRLS. Running the app as the owner disables every tenant
# policy silently, so this must never be the owner's connection string.
DATABASE_URL=postgres://rekoda_app@localhost:5432/rekoda
# Owner connection, used ONLY to run migrations (pnpm --filter @rekoda/db
# migrate:apply) and never by a running application.
OWNER_DATABASE_URL=postgres://rekoda@localhost:5432/rekoda
# What the WORKER uses: the rekoda_worker role. Identical to rekoda_app in every
# respect but one — it may read and claim a row in `jobs` before a tenant is
# known, because you cannot pin the tenant of a job you have not read yet
# (ADR 0022). Everything the worker does AFTER the claim runs under an ordinary
# tenant pin. There is deliberately no fallback to DATABASE_URL: a runner
# holding the app role would see a permanently empty queue and jobs would pile
# up in silence.
WORKER_DATABASE_URL=postgres://rekoda_worker@localhost:5432/rekoda
# Set to 1 to make this process poll the queue as well as serve requests. One
# image, two roles: in development a single process does both, in production
# they scale apart.
REKODA_WORKER=0

# ── Security keys (generate each: openssl rand -hex 32) ────────────────────
# Encrypts vault ciphertexts (customer identities) AND sealed webhook payloads.
# REQUIRED — the API refuses to boot without it, because a deployment missing
# it cannot read an inbound message or store a customer, and finding that out
# at the first real message is worse than finding it out at boot.
# Rotation = re-encryption migration; see docs/runbooks/key-rotation.md (M2).
VAULT_KEY=
# Keyed HMAC for deterministic identity matching. REQUIRED, and deliberately
# NOT the vault key: it is what makes a stored match key un-reversible, so
# holding one must not imply holding the other.
MATCH_KEY=
# Encrypts merchant provider credentials (Paystack keys etc.).
CONNECTION_KEY=
# Session cookie signing.
SESSION_SECRET=
# Signs setup grants — the short-lived credential that bridges "phone verified"
# and "business exists" (ADR 0020). Minimum 32 characters; the API refuses to
# boot without it.
REKODA_API_SECRET=
# Server-side pepper for OTP hashing, never stored beside the hash. A 6-digit
# code under an unsalted digest is a 10^6 keyspace and reversible in under a
# second, so a database dump alone must not be enough to invert it.
# Minimum 32 characters. Changing it invalidates every OTP in flight.
OTP_PEPPER=

# ── Test hooks — MUST be unset everywhere real ─────────────────────────────
# Returns live OTP codes in the API response so the end-to-end suite can
# complete the flow without a WhatsApp account. The API REFUSES TO BOOT with
# this set when NODE_ENV=production. Set only by playwright.config.ts.
# REKODA_REVEAL_OTP=1
# REKODA_E2E_REVEAL_OTP=1

# ── WhatsApp — Rekoda Chat (Meta Cloud API direct, ADR 0002/0011) ──────────
# Sends replies. Unset, every inbound message is still recorded and answered
# in the database — the reply simply is not delivered, which is what a provider
# outage looks like too. A developer running the stack does not need a WhatsApp
# Business account.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v21.0
# USD micros per in-window service reply. Zero today: Meta does not charge for
# them yet. Chargeable from 1 October 2026 — this is the number to change, and
# the usage_events rows being written now are the baseline to compare against.
META_SERVICE_REPLY_COST_MICROS=0
# Signs every inbound webhook (X-Hub-Signature-256). REQUIRED in production —
# the API refuses to boot without it. Left empty elsewhere, signature checks
# return false for everything, so a misconfigured deployment rejects webhooks
# rather than accepting unsigned ones. That is the safe direction to fail.
META_APP_SECRET=
# Echoed during Meta's GET subscription handshake. Any long random string;
# it proves to Meta that the endpoint is ours. REQUIRED in production.
META_VERIFY_TOKEN=

# ── Paystack (the Payment Hub's first adapter + Rekoda's own billing) ──────
# Signs Paystack webhooks (HMAC-SHA512) AND authenticates Paystack API calls
# — Paystack uses one secret for both. Empty means every webhook is rejected,
# which is the safe direction for a deployment that has not turned payments
# on. Payments do not go live until the payments-v1 §47 platform-model
# confirmation from Paystack is in writing.
PAYSTACK_SECRET_KEY=
# Paystack's API host. Leave unset in every real deployment (defaults to
# https://api.paystack.co); tests and sandboxes point it at a fake.
# PAYSTACK_BASE_URL=
PAYSTACK_PLAN_CHAT=
PAYSTACK_PLAN_INTEGRATE=
PAYSTACK_PLAN_COMPLETE=

# ── AI (ADR 0007) ──────────────────────────────────────────────────────────
# Which provider interprets a merchant's message: anthropic | openai.
#
# Leave unset and whichever key is present is used; if BOTH are present,
# Anthropic, because ADR 0007 names Sonnet the default brain and a coin toss
# is not a routing policy. Set it explicitly and the matching key becomes
# REQUIRED — a typo should fail at boot, not silently use the other provider.
#
# Not a failover pair: extraction quality IS the product experience, so which
# model reads a sentence about money is a decision someone makes, not one a
# network blip makes for them.
AI_PROVIDER=

# Both optional. With neither, the API behaves as if the provider is down: the
# deterministic router still answers greetings, confirmations and "who owes
# me" without a model, so a missing key degrades the product rather than
# breaking it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Follows the provider when unset — a model id is not portable between them.
# claude-sonnet-latest for anthropic, gpt-4.1 for openai.
AI_MODEL_DEFAULT=
AI_MODEL_CLASSIFIER=claude-haiku-latest
# Escalation tier — OFF at launch; set a model id to enable.
AI_MODEL_ESCALATION=

# ── STT sidecar (ADR 0005) ─────────────────────────────────────────────────
STT_URL=http://localhost:8081
# Fallback provider if the accent benchmark demands it (privacy copy must
# be updated when enabled): openai | none
# Uses the same OPENAI_API_KEY declared in the AI section above — one key, one
# place to rotate it.
STT_FALLBACK=none

# ── Object storage (Cloudflare R2, ADR 0006) ───────────────────────────────
# Unset, documents are rendered and then fail to store — loudly, the way an
# outage does. There is deliberately NO silent filesystem fallback: a
# deployment quietly writing invoices to a container's local disk would lose
# every one of them on the next restart, and would look fine until someone
# asked for a document back.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rekoda-documents

# Development only, and only when set explicitly: store documents on disk here
# instead of R2. Never set this in production.
REKODA_LOCAL_STORAGE=

# Daily AI-call ceilings — a ceiling, not a target (MASTER-PLAN §5.3.3).
# At ~8 naira a call, 60 per merchant is ~480 naira/day against a
# subscription; 5,000 platform-wide bounds the worst day this product can have
# to ~40,000 naira — absorbable while someone investigates, rather than
# discovered on an invoice.
AI_DAILY_CALLS_PER_BUSINESS=60
AI_DAILY_CALLS_GLOBAL=5000

# ── The AI ensemble (docs/ai-model-strategy.md) ─────────────────────────────
# Every AI call belongs to a ROLE, and each role's model is one env var away.
# Unset means the documented default: Haiku for cheap classification, Sonnet
# for interpretation and vision, Opus only behind the confidence gate, and
# OpenAI for transcription (the Claude API accepts no audio).
# AI_MODEL_CLASSIFIER=
# AI_MODEL_VISION=
# AI_MODEL_ESCALATION=
# AI_MODEL_TRANSCRIBER=

# Longest voice note Rekoda will transcribe, in seconds (rekoda-chat-v1 §2).
# A commercial limit, so it lives here and never in application logic; an
# over-length note gets a natural "send it in shorter parts" reply.
VOICE_NOTE_MAX_DURATION_SECONDS=120

# ── Cost telemetry ─────────────────────────────────────────────────────────
# Planning FX for naira-equivalent COGS rows (pricing-model.md).
PLANNING_FX_NGN_PER_USD=1450
