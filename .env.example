# ══════════════════════════════════════════════════════════════════════════
# Rekoda — environment configuration
# Copy to .env and fill. The application refuses to boot with missing or
# malformed values and names the exact problem (doctor-on-boot).
# NOTHING in this file's real counterpart is ever committed.
# ══════════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public origin, no trailing slash (webhooks, links, canonical URLs).
APP_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────
# Dev matches docker-compose.dev.yml. Production: the rekoda_app role — the
# RLS-constrained application role, never the table owner.
DATABASE_URL=postgres://rekoda:rekoda@localhost:5432/rekoda

# ── Security keys (generate each: openssl rand -hex 32) ────────────────────
# Encrypts vault ciphertexts (customer identities). Rotation = re-encryption
# migration; see docs/runbooks/key-rotation.md (M2).
VAULT_KEY=
# Keyed HMAC for deterministic identity matching (separate from VAULT_KEY).
MATCH_KEY=
# Encrypts merchant provider credentials (Paystack keys etc.).
CONNECTION_KEY=
# Session cookie signing.
SESSION_SECRET=

# ── WhatsApp — Rekoda Chat (Meta Cloud API direct, ADR 0002) ───────────────
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ── Paystack (Rekoda's own billing) ────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CHAT=
PAYSTACK_PLAN_INTEGRATE=
PAYSTACK_PLAN_COMPLETE=

# ── AI (ADR 0007) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-latest
AI_MODEL_CLASSIFIER=claude-haiku-latest
# Escalation tier — OFF at launch; set a model id to enable.
AI_MODEL_ESCALATION=

# ── STT sidecar (ADR 0005) ─────────────────────────────────────────────────
STT_URL=http://localhost:8081
# Fallback provider if the accent benchmark demands it (privacy copy must
# be updated when enabled): openai | none
STT_FALLBACK=none
OPENAI_API_KEY=

# ── Object storage (Cloudflare R2, ADR 0006) ───────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rekoda-documents

# ── Cost telemetry ─────────────────────────────────────────────────────────
# Planning FX for naira-equivalent COGS rows (pricing-model.md).
PLANNING_FX_NGN_PER_USD=1450
